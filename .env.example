# Скопируйте в apps/api/.env и заполните реальными значениями.
# Никогда не коммитьте .env с настоящими секретами.

NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api/v1

DATABASE_URL=postgresql://topla:topla@localhost:5432/topla?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=30d

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

SMS_PROVIDER_API_KEY=
TELEGRAM_BOT_TOKEN=
EMAIL_SMTP_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
